  "search": [
    {
      "id": "specific_event_name",
      "query": "洛杉矶马拉松",
      "expect_events": [
        "洛杉矶马拉松"
      ],
      "note": "回归：原实现是纯 OR 匹配，这个查询会返回全部三组"
    },
    {
      "id": "city_only",
      "query": "东京",
      "expect_events": [
        "东京马拉松"
      ]
    },
    {
      "id": "city_prefix",
      "query": "洛杉矶",
      "expect_events": [
        "洛杉矶马拉松"
      ]
    },
    {
      "id": "half_marathon",
      "query": "半马",
      "expect_events": [
        "上海半马"
      ]
    },
    {
      "id": "no_match",
      "query": "北京马拉松",
      "expect_events": []
    },
    {
      "id": "by_year",
      "query": "2025",
      "expect_events": [
        "东京马拉松",
        "上海半马"
      ]
    },
    {
      "id": "empty_query",
      "query": "",
      "expect_events": []
    }
  ],
  "merge": [
    {
      "id": "merge_orphan_into_group",
      "source": "fx-orphan",
      "target": "fx-la",
      "expect_groups": [
        "洛杉矶马拉松",
        "东京马拉松",
        "上海半马"
      ],
      "expect_target_photos": 9,
      "note": "真实场景：意图识别之前「再加上这张」被当成新建，同一场比赛被拆成两组"
    },
    {
      "id": "merge_fills_missing_meta",
      "source": "fx-la",
      "target": "fx-orphan",
      "expect_groups": [
        "未命名照片",
        "东京马拉松",
        "上海半马"
      ],
      "expect_target_photos": 9,
      "expect_target_result": "4:30:48",
      "note": "目标缺的字段用来源补上"
    },
    {
      "id": "merge_same_group_rejected",
      "source": "fx-la",
      "target": "fx-la",
      "expect_groups": [
        "洛杉矶马拉松",
        "东京马拉松",
        "上海半马",
        "未命名照片"
      ],
      "expect_error": true,
      "note": "同一组不能自己合自己"
    },
    {
      "id": "merge_unknown_rejected",
      "source": "fx-nope",
      "target": "fx-la",
      "expect_groups": [
        "洛杉矶马拉松",
        "东京马拉松",
        "上海半马",
        "未命名照片"
      ],
      "expect_error": true
    }
  ],
  "intent_guard": [
    {
      "id": "match_ids_unknown_dropped",
      "raw": {
        "action": "search",
        "match_ids": [
          "fx-la",
          "fx-nope",
          "fx-la"
        ]
      },
      "has_attachments": false,
      "expect": {
        "action": "search",
        "match_ids": [
          "fx-la"
        ]
      },
      "note": "模型编出来的 id 要丢掉，重复的要去重"
    },
    {
      "id": "match_ids_only_for_search",
      "raw": {
        "action": "update",
        "target_id": "fx-la",
        "match_ids": [
          "fx-tokyo"
        ]
      },
      "has_attachments": false,
      "expect": {
        "action": "update",
        "match_ids": []
      },
      "note": "非搜索动作不该带 match_ids"
    },
    {
      "id": "merge_needs_both_ids",
      "raw": {
        "action": "merge",
        "target_id": "fx-la",
        "source_id": ""
      },
      "has_attachments": false,
      "expect": {
        "action": "help",
        "source_id": ""
      },
      "note": "只指定一组就不敢合并——删错组不可逆"
    },
    {
      "id": "merge_rejects_self",
      "raw": {
        "action": "merge",
        "target_id": "fx-la",
        "source_id": "fx-la"
      },
      "has_attachments": false,
      "expect": {
        "action": "help",
        "source_id": ""
      }
    },
    {
      "id": "attachments_cannot_merge",
      "raw": {
        "action": "merge",
        "target_id": "fx-la",
        "source_id": "fx-tokyo"
      },
      "has_attachments": true,
      "expect": {
        "action": "create",
        "source_id": ""
      },
      "note": "带图不可能是合并"
    },
    {
      "id": "no_attachments_cannot_create",
      "raw": {
        "action": "create"
      },
      "has_attachments": false,
      "expect": {
        "action": "search"
      },
      "note": "没有附件不可能新建"
    },
    {
      "id": "append_without_target_degrades",
      "raw": {
        "action": "append",
        "target_id": "fx-nope"
      },
      "has_attachments": true,
      "expect": {
        "action": "create",
        "target_id": ""
      },
      "note": "追加目标不存在就降级成新建，不能凭空追加"
    },
    {
      "id": "invalid_action_rejected",
      "raw": {
        "action": "delete_everything"
      },
      "has_attachments": false,
      "expect": {
        "action": "help"
      },
      "note": "词表外的动作一律作废"
    }
  ]
}
