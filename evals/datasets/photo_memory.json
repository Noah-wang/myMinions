{
  "extraction": [
    {
      "id": "real_chinese_duration",
      "text": "比赛成绩是四小时三十分48 比赛日期是2026年3月8日",
      "expect": {
        "race_date": "2026-03-08",
        "result": "4:30:48"
      },
      "note": "真实回归：用户在 Discord 实际发的内容，原实现两项都抽不出成绩"
    },
    {
      "id": "real_colon_with_connector",
      "text": "比赛成绩是4:30:48",
      "expect": {
        "race_date": "",
        "result": "4:30:48"
      },
      "note": "真实回归：关键词和数字之间的「是」原来会把正则挡住"
    },
    {
      "id": "store_with_all_fields",
      "text": "这是我洛杉矶马拉松的比赛照片，2026年3月17日，成绩 4:30:00",
      "expect": {
        "event": "洛杉矶马拉松",
        "race_date": "2026-03-17",
        "result": "4:30:00"
      }
    },
    {
      "id": "event_with_verb_prefix",
      "text": "帮我存一下柏林马拉松的照片",
      "expect": {
        "event": "柏林马拉松"
      },
      "note": "回归：原实现会把「帮我存一下」也当成赛事名的一部分"
    },
    {
      "id": "event_half_marathon",
      "text": "这是我上海半马的照片",
      "expect": {
        "event": "上海半马"
      }
    },
    {
      "id": "event_la_english",
      "text": "This is my LA Marathon photo",
      "expect": {
        "event": "洛杉矶马拉松"
      }
    },
    {
      "id": "event_unknown",
      "text": "随便一张自拍",
      "expect": {
        "event": "未命名照片",
        "race_date": "",
        "result": ""
      }
    },
    {
      "id": "duration_digits_with_seconds",
      "text": "4小时30分48秒",
      "expect": {
        "result": "4:30:48"
      }
    },
    {
      "id": "duration_no_seconds",
      "text": "用时四小时三十分",
      "expect": {
        "result": "4:30:00"
      }
    },
    {
      "id": "duration_zero_filler",
      "text": "成绩是十小时零五分",
      "expect": {
        "result": "10:05:00"
      },
      "note": "「零五」这类补位写法"
    },
    {
      "id": "pace_not_a_result",
      "text": "我半马配速是 4:30",
      "expect": {
        "result": ""
      },
      "note": "没有成绩类关键词，不能把配速当成绩"
    },
    {
      "id": "date_not_a_result",
      "text": "比赛日期是2026年3月8日",
      "expect": {
        "race_date": "2026-03-08",
        "result": ""
      },
      "note": "日期不能被当成成绩"
    },
    {
      "id": "month_only_date",
      "text": "这是我东京马拉松的照片，2025年3月",
      "expect": {
        "event": "东京马拉松",
        "race_date": "2025-03"
      }
    }
  ],
